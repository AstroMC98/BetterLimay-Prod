{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BetterLimay Barangay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "punongBarangay",
    "coordinates",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "punongBarangay": {
      "type": [
        "string",
        "null"
      ]
    },
    "coordinates": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "profile": {
      "type": "string"
    },
    "provenance": {
      "$ref": "./provenance.schema.json"
    },
    "psgcCode": {
      "type": "string",
      "pattern": "^[0-9]{10}$"
    },
    "classification": {
      "type": "string",
      "enum": [
        "urban",
        "rural"
      ]
    },
    "population2024": {
      "type": "integer",
      "minimum": 0
    },
    "contactPhone": {
      "type": "string",
      "minLength": 1,
      "description": "The barangay's own line. Never a personal number."
    },
    "term": {
      "type": "string"
    },
    "officials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "position"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "First name, middle initial, last name, suffix. Never a full middle name."
          },
          "position": {
            "type": "string",
            "minLength": 1
          },
          "termInPosition": {
            "type": "string"
          }
        }
      }
    }
  }
}
