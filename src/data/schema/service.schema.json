{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BetterLimay Public Service",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slug", "category", "title", "eligibleApplicants", "requirements", "steps", "fees", "processingTime", "responsibleOfficeId", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "category": {
      "type": "string",
      "enum": ["business-permits", "civil-registry", "real-property-tax", "treasurer", "health", "social-welfare", "engineering-building", "agriculture", "environment", "drrm", "education-scholarships", "barangay-clearances"]
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "eligibleApplicants": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "requirements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "actor", "action"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "actor": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fees": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "amount"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "amount": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" }
        }
      }
    },
    "processingTime": { "type": "string", "minLength": 1 },
    "responsibleOfficeId": { "type": "string", "minLength": 1 },
    "responsibleOfficeName": {
      "type": "string",
      "minLength": 1,
      "description": "Office name as printed in the source, for records whose office is not in offices.json (peer-LGU references)."
    },
    "providerEntity": {
      "type": "string",
      "minLength": 1,
      "description": "The entity that actually provides this service."
    },
    "providerScope": {
      "type": "string",
      "enum": ["municipal", "peer-lgu-reference", "provincial", "gocc", "national-agency"],
      "description": "Anything other than 'municipal' MUST be rendered visibly. A peer-LGU record shows another municipality's process while Limay's own charter is unavailable; its fees and processing times are that municipality's facts, not Limay's."
    },
    "charterEdition": {
      "type": "string",
      "minLength": 1,
      "description": "Edition of the charter this record was taken from."
    },
    "sourcePage": {
      "type": "integer",
      "minimum": 1,
      "description": "Page in that charter, so a maintainer can check the fee without re-reading the document."
    },
    "sourceDocumentUrl": { "type": "string", "format": "uri" },
    "dataGapIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^GAP-[0-9]{3}(?:-[A-Z]+)?$" }
    },
    "provenance": { "$ref": "./provenance.schema.json" }
  }
}
