# Browser-visible configuration. Leave blank until the public provider key is approved.
VITE_TURNSTILE_SITE_KEY=

# Server-only configuration. Do not expose these through Vite client variables.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
REPORT_DELIVERY_TARGET=disabled
REPORT_DELIVERY_EMAIL=
REPORT_DELIVERY_GITHUB_REPOSITORY=
REPORT_DELIVERY_DISCORD_WEBHOOK_URL=
REPORT_RATE_LIMIT_REQUESTS=5
REPORT_RATE_LIMIT_WINDOW_SECONDS=900
REPORT_RATE_LIMIT_HASH_SALT=
# Upstash for Redis. Added through the Vercel Marketplace it sets KV_REST_API_URL
# and KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
# Until betterlimay.org is verified in Resend: BetterLimay <onboarding@resend.dev>
# (that sender can only deliver to the address the Resend account was created with).
REPORT_FROM_EMAIL=

# Optional public portal configuration.
VITE_PORTAL_BASE_URL=https://betterlimay.org

# Data pipeline only. Never referenced by the browser bundle or by any Vercel
# function; used solely by `python pipeline/5_extract.py` on a maintainer's
# machine. Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Content editor at /admin. Server-only: these complete the GitHub OAuth
# exchange that a browser cannot do safely, because it needs the client secret.
# Create a GitHub OAuth App with the callback https://<your-domain>/api/admin-auth
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
